<?import com.comp2042.GameOverPanel?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.Group?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import java.net.URL?>

<!--Pane does not auto resize the game so i am changing to stackPane which will center my tetris board automatically and allow resizing-->
<!--StackPane is my black background which fills the entire window-->
<?import javafx.scene.image.ImageView?>
<StackPane fx:controller="com.comp2042.GuiController"
           xmlns:fx="http://javafx.com/fxml"
           styleClass="rootPane">

  <!--Adding Hbox so my side panel and game lie next to each other-->
  <HBox alignment="CENTER" spacing="40">
      <!--Anchor pane is my tetris area which stays centered and locked-->
       <AnchorPane fx:id="rootContainer"
                   prefWidth="500" prefHeight="800"
                   minWidth="500" minHeight="800"
                   maxWidth="500" maxHeight="800"
                   styleClass="gameContainer" >

        <GridPane fx:id="brickPanel" vgap="1" hgap="1" layoutX="600" layoutY="100"/>
        <BorderPane styleClass="gameBoard" fx:id="gameBoard"
                AnchorPane.topAnchor="0"
                AnchorPane.leftAnchor="0"
                AnchorPane.rightAnchor="0"
                AnchorPane.bottomAnchor="0" >
          <center>
              <GridPane fx:id="gamePanel"
                        hgap="1" vgap="1"
                        layoutX="50" layoutY="50"
                        AnchorPane.leftAnchor="0"
                        AnchorPane.rightAnchor="0"
                        AnchorPane.topAnchor="0"
                        AnchorPane.bottomAnchor="0"
                        alignment="CENTER"/><!--aligning game panel to center-->
         </center>

        </BorderPane>

         <Group fx:id="groupNotification" layoutX="14" layoutY="203">
            <VBox alignment="CENTER">
               <GameOverPanel fx:id="gameOverPanel"/>
           </VBox>
         </Group>
    </AnchorPane>
      <VBox fx:id="sidePanel" alignment="TOP_CENTER" spacing="30">
          <Label text="Score:" styleClass="scoreClass"/>
          <Label fx:id="scoreLabel" text="0" styleClass="scoreClass"/>

          <Label text="Next:" styleClass="nextBrickLabel"/>
          <GridPane fx:id="nextBrickPanel"
                    alignment="CENTER"
                    prefWidth="100" prefHeight="100"
                    hgap="2" vgap="2"
                    style="-fx-border-color: white; -fx-border-width: 2;"/>

          <Label text="Level:" styleClass="scoreClass"/>
          <Label fx:id="levelLabel" text="1" styleClass="scoreClass"/>
      </VBox>

  </HBox>



    <stylesheets>
        <URL value="@window_style.css"/>
    </stylesheets>
</StackPane>