<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import java.net.URL?>
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.comp2042.MainMenuController"
           prefHeight="400.0" prefWidth="600.0">

    <ImageView fx:id="backgroundImage"
               fitHeight="800"
               fitWidth="600"
               preserveRatio="false"/>

    <VBox alignment="CENTER" spacing="20">
        <HBox alignment="CENTER" spacing="40">
            <Button fx:id="marathonButton" text="Marathon Mode" styleClass="menu-button" />
            <Button fx:id="ultraButton" text="Ultra Mode" styleClass="menu-button" />
            <Button fx:id="sprintButton" text="Sprint Mode" styleClass="menu-button" />
        </HBox>



        <Button fx:id="exitButton" text="Exit" styleClass="menu-button" />
    </VBox>
    <stylesheets>
        <URL value="@window_style.css"/>
    </stylesheets>
</StackPane>
