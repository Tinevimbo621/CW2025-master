<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Pos?>

<?import java.net.URL?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.comp2042.Main"
            prefHeight="400.0" prefWidth="600.0"
            style="-fx-background-color: linear-gradient(to bottom, #1e3c72, #2a5298);">

    <VBox alignment="CENTER" spacing="15"
          AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

        <Button fx:id="startButton" text="Start Game" styleClass="startButton"/>
        <Button fx:id="settingsButton" text="Settings" styleClass="settingsButton"/>
        <Button fx:id="exitButton" text="Exit" styleClass="exitButton"/>

    </VBox>

    <stylesheets>
        <URL value="@window_style.css"/>
    </stylesheets>
</AnchorPane>
